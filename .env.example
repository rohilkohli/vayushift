# Everything here is optional for local development: with no values the app runs on bundled demo data,
# in-memory storage and template text. Copy to .env.local and fill in only what you need. Never commit real values.

# --- Upstreams (server-side only; in production they come from Secret Manager) ---
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Storage ---
# memory (default) or firestore. Firestore needs GOOGLE_CLOUD_PROJECT, or FIRESTORE_EMULATOR_HOST for local use.
STORAGE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Public URL, used to build share links (https, no trailing slash). Required in production. ---
PUBLIC_ORIGIN=

# --- Proxies in front of the app that append to X-Forwarded-For. Cloud Run alone: 1. Behind an external HTTPS load balancer: 2. ---
TRUSTED_PROXY_HOPS=1

# --- Daily call caps for paid upstreams (UTC day). 0 switches an upstream off. ---
# BUDGET_AIR_QUALITY_DAILY=20000
# BUDGET_GEMINI_VISION_DAILY=300
# BUDGET_GEMINI_EXPLAIN_DAILY=2000

# --- Caching and retention ---
# AIR_CACHE_FRESH_MINUTES=30
# AIR_CACHE_STALE_MINUTES=180
# EXPLAIN_CACHE_HOURS=24
# RECEIPT_TTL_DAYS=90

# --- Logging: debug | info | warn | error | silent ---
# LOG_LEVEL=info
